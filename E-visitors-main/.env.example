# Frontend environment variables (E-visitors-main)

# Public URL of this frontend (used for cookie/domain and some redirects)
VITE_APP_URL=http://localhost:3000

# Base URL of the backend API (must be reachable from the browser)
VITE_API_URL=http://localhost:3000

# Cloudinary (only required if the app uploads images)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

